# Copia este fichero a android/keystore.properties y rellena los valores.
# Nunca se sube a git: sin la clave, ningún dispositivo con la app instalada
# podría volver a actualizarse.
#
# Generar la clave (una sola vez, y guardar copia FUERA del proyecto):
#   node scripts/keystore.mjs
storeFile=perfectrest-release.jks
storePassword=CAMBIAME
keyAlias=perfectrest
keyPassword=CAMBIAME
