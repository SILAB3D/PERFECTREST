<?xml version="1.0" encoding="utf-8"?>
<!-- Ventana de arranque en Android 11 y anteriores (en 12+ manda
     `values-v31/styles.xml`). Vectorial: un solo fichero en vez de los diez
     PNG por densidad y orientación que traía la plantilla. -->
