<?xml version="1.0" encoding="utf-8"?>
<!-- Capa frontal del icono adaptativo. El dibujo vive en un lienzo de 100x100
     (el mismo que `public/logo.svg`) y el grupo lo encaja en los 108dp del
     icono ocupando 60dp: la línea guía de Material para una marca circular.

     Antes ocupaba 70dp. Eso cabe por los pelos en la zona segura de 72dp que
     Android promete, pero no deja margen para nada más: el lanzador aplica
     paralaje al mover el icono, los iconos temáticos de Android 13 lo
     reencuadran, y varias máscaras de fabricante recortan por debajo de los
     72dp. Con 60dp la marca respira y ninguna máscara le come el arco. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.79470"
        android:scaleY="0.79470"
        android:translateX="14.265"
        android:translateY="14.265">
        <path
            android:pathData="M44.1,16.52A34,34 0 1 0 84,50"
            android:strokeWidth="7.5"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="12" android:startY="12"
                    android:endX="88" android:endY="88">
                    <item android:offset="0" android:color="#A594FF"/>
                    <item android:offset="0.55" android:color="#8E7BFF"/>
                    <item android:offset="1" android:color="#4FE0BE"/>
                </gradient>
            </aapt:attr>
        </path>
        <path android:pathData="M36.68,32.77A22,22 0 1 0 67.23,63.32A28,28 0 0 1 36.68,32.77Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="12" android:startY="12"
                    android:endX="88" android:endY="88">
                    <item android:offset="0" android:color="#A594FF"/>
                    <item android:offset="0.55" android:color="#8E7BFF"/>
                    <item android:offset="1" android:color="#4FE0BE"/>
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
